---
layout: null
---
[
{% for p in site.posts %}
  {
    "title": {{ p.title | jsonify }},
    "url": {{ p.url | relative_url | jsonify }},
    "category": {{ p.categories | first | jsonify }},
    "tags": {{ p.tags | join: " " | jsonify }},
    "date": {{ p.date | date: "%Y-%m-%d" | jsonify }},
    "body": {{ p.content | strip_html | strip_newlines | normalize_whitespace | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
